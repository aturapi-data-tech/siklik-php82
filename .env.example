APP_NAME=Siklik
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Zona waktu aplikasi; dibaca lewat config('app.timezone') — dipakai antara lain
# untuk kolom date_ref di WEB_LOG_STATUS (log panggilan API BPJS/SATUSEHAT).
# UTC = perilaku bawaan Laravel & keadaan siklik saat ini; ubah ke Asia/Jakarta
# hanya bila log memang ingin waktu lokal (memengaruhi data historis campuran).
APP_TIMEZONE=UTC

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===========================================
# DATABASE
# ===========================================
# Untuk produksi pakai oracle_siklik (perlu kredensial DB Oracle).
# Untuk testing layout/auth tanpa Oracle, pakai sqlite.
DB_CONNECTION=oracle_siklik

# Oracle Siklik connection
SIKLIK_DB_HOST=127.0.0.1
SIKLIK_DB_PORT=1521
SIKLIK_DB_DATABASE=
SIKLIK_DB_SERVICE_NAME=orcl
SIKLIK_DB_USERNAME=
SIKLIK_DB_PASSWORD=

# Oracle Mindray (alat lab analyzer — opsional, isi kalau pakai integrasi Mindray)
MINDRAY_DB_HOST=
MINDRAY_DB_PORT=1521
MINDRAY_DB_DATABASE=
MINDRAY_DB_SERVICE_NAME=
MINDRAY_DB_USERNAME=
MINDRAY_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===========================================
# BPJS PCare (klinik pratama)
# ===========================================
# Dibaca lewat config('bpjs.pcare.*').
PCARE_URL=
PCARE_CONS_ID=
PCARE_SECRET_KEY=
PCARE_USER_KEY=
PCARE_USERNAME=
PCARE_PASSWORD=
PCARE_DESC=
PCARE_PROVIDER=

# ===========================================
# BPJS Antrean FKTP (Mobile JKN — Web Service Antrean)
# Klinik = server, BPJS = client. Kredensial ini yang kita daftarkan
# ke BPJS supaya mereka bisa hit /api/auth → JWT → endpoint antrean.
# ===========================================
# Dibaca lewat config('bpjs.antrean_fktp.*') — JANGAN env() di dalam app/.
ANTREAN_USERNAME=
ANTREAN_PASSWORD=
BPJS_JWT_SECRET=

# ===========================================
# BPJS Antrean RS — outbound (klinik → BPJS server)
# Dipakai oleh AntrianTrait untuk pull jadwal dokter dari BPJS
# (mis. /master/jadwal-mingguan). Kredensial issued oleh BPJS.
# ===========================================
# Dibaca lewat config('bpjs.antrian.*').
ANTRIAN_URL=
ANTRIAN_CONS_ID=
ANTRIAN_SECRET_KEY=
ANTRIAN_USER_KEY=
# Endpoint antrean BPJS lebih lambat dari PCare; kosongkan untuk pakai bawaan 15 dtk.
# ANTRIAN_HTTP_TIMEOUT=15

# ===========================================
# BPJS i-Care JKN (riwayat pelayanan peserta)
# Dibaca lewat config('bpjs.icare.*').
# ===========================================
ICARE_URL=
ICARE_CONS_ID=
ICARE_SECRET_KEY=
ICARE_USER_KEY=

# ===========================================
# BPJS — jalur keluar (whitelist IP publik)
# ===========================================
# BPJS mem-whitelist IP publik pemanggil API (berlaku 2 Sep 2026, pengajuan lewat
# ITSM BPJS). Bila yang didaftarkan adalah IP VPS — bukan IP klinik — SEMUA panggilan
# BPJS (PCare, Antrean, i-Care) harus keluar lewat forward proxy di VPS itu.
# Lihat docs/bpjs-whitelist-ip-proxy.md. SATUSEHAT TIDAK lewat proxy ini.
#
# BPJS_PROXY_AKTIF adalah SAKLAR (bawaan false = langsung, keadaan produksi saat ini).
# URL boleh diisi duluan; nyalakan saklarnya saat BPJS mulai menegakkan whitelist.
BPJS_PROXY_AKTIF=false
BPJS_PROXY_URL=
BPJS_IP_WHITELIST=
# BPJS_HTTP_TIMEOUT=10
# BPJS_HTTP_CONNECT_TIMEOUT=3
# BPJS_IP_ECHO_URL=https://api.ipify.org?format=json

# ===========================================
# Satu Sehat (Kemenkes — FHIR registry)
# Dibaca lewat config('satusehat.*'). TIDAK lewat proxy BPJS.
# ===========================================
SATUSEHAT_ORGANIZATION_ID=
SATUSEHAT_ORGANIZATION_NAME=
SATUSEHAT_AUTH_URL=
SATUSEHAT_BASE_URL=
SATUSEHAT_CLIENT_ID=
SATUSEHAT_SECRET_ID=
# SATUSEHAT_HTTP_TIMEOUT=10
